%% EasyPaste 功能增强 — 类图

classDiagram
    class ClipSubkind {
        <<enum>>
        +richText
        +email
        +json
    }

    class Clip {
        +UUID id
        +ClipKind kind
        +ClipSubkind? subkind
        +String? contentHash
        +UUID? boardID
        +String? title
        +Date createdAt
        +String? text
        +URL? url
        +Data? imageData
        +Bool isFavorite
        +[UTIEntry]? allPasteboardData
        +isColorValue: Bool
        +resolvedColorValue: Color?
        +attributedText: NSAttributedString?
        +previewPlainText: String?
    }

    class ClipKind {
        <<enum>>
        +text
        +link
        +image
        +file
        +color
    }

    class AppSettings {
        +Bool hideDockIcon
        +onDockIconVisibilityChanged: (() -> Void)?
        +save()
        +load()
    }

    class ClipboardStore {
        -[Clip] items
        -DatabaseQueue dbQueue
        +add(Clip)
        +toggleFavorite(UUID)
        +delete(Set~UUID~)
        -clipHash(Clip) String
        -writeClip(Clip)
        -promoteClip(at: Int)
    }

    class ClipboardService {
        -Int lastChangeCount
        +start()
        +stop()
        -readIfChanged()
        -makeItem() Clip?
        +copy(Clip, plainText: Bool)
        +paste(Clip, plainText: Bool)
    }

    class ClipTypeDetector {
        <<struct, 无状态>>
        +detect(text, allPasteboardData) ClipSubkind?
        +isRichText([UTIEntry]) Bool
        +isJSON(String) Bool
        +isEmail(String) Bool
        +computeContentHash([UTIEntry]) String?
        +computeFallbackHash(kind, title, detail) String
    }

    class ClipActionService {
        -ClipboardService clipboard
        -PanelState panelState
        +showQRCode(content: String)
        +exportAsText(Clip)
        +exportAsRTF(Clip)
        +exportAsImage(Clip)
        +sendEmail(address: String)
        +copyColorHex(Clip)
        +copyColorRGB(Clip)
        +copyColorHSL(Clip)
        +openURL(URL)
        +previewJSON(Clip)
    }

    class PanelState {
        +UUID? selectedID
        +Clip? previewItem
        +String? qrCodeContent
        +Clip? jsonPreviewItem
    }

    class ClipRow {
        +String id
        +String kind
        +String? subkind
        +String? contentHash
        +Double createdAt
        +toClip(blob) Clip
    }

    class DatabaseManager {
        +open(URL) DatabaseQueue
        +migrator
    }

    class ClipCardView {
        +Clip item
        -contextMenu
        -typeSpecificMenu
    }

    class PanelView {
        -previewOverlay(Clip)
        -qrCodeOverlay(String)
        -jsonPreviewOverlay(Clip)
    }

    class QRCodeView {
        +String content
        -generateQR() NSImage?
    }

    class JSONPreviewView {
        +String jsonText
        -formattedText: String
    }

    Clip --> ClipSubkind : subkind?
    Clip --> ClipKind : kind
    ClipRow --> Clip : toClip()
    ClipboardStore --> Clip : items
    ClipboardStore --> DatabaseQueue : dbQueue
    ClipboardService --> Clip : makeItem()
    ClipTypeDetector --> Clip : detect()
    ClipTypeDetector --> ClipSubkind : returns
    ClipActionService --> ClipboardService : clipboard
    ClipActionService --> PanelState : triggers preview
    PanelState --> Clip : previewItem / jsonPreviewItem
    ClipCardView --> ClipActionService : invokes actions
    PanelView --> PanelState : reads state
    PanelView --> QRCodeView : renders
    PanelView --> JSONPreviewView : renders
    DatabaseManager --> DatabaseQueue : creates
    AppSettings --> ClipboardStore : configures
